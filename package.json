{
  "name": "@elinzy/e-utils",
  "moduleName": "eUtils",
  "version": "0.4.9",
  "description": "e 工具类，常见 JavaScript / TypeScript 实用程序合集",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js"
  },
  "files": [
    "dist",
    "*.d.ts"
  ],
  "scripts": {
    "test:dev": "vitest --config vitest.config.mts",
    "test:coverage": "vitest --coverage --typecheck",
    "build": "tsx scripts/build-run.ts",
    "build:rollup": "rollup -c rollup.config.mjs",
    "build:types": "tsc --noEmit",
    "build:clean": "tsx scripts/clean.ts",
    "build:changelog": "changeset && tsx scripts/changelog.ts",
    "ci:publish": "tsx scripts/publish.ts",
    "ci:release": "tsx scripts/release.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Appleec/e-utils.git"
  },
  "keywords": [
    "e",
    "utils",
    "e-utils"
  ],
  "author": "appleex <771992522@qq.com>",
  "license": "MIT",
  "private": false,
  "bugs": {
    "url": "https://github.com/Appleec/e-utils/issues"
  },
  "homepage": "https://github.com/Appleec/e-utils#readme",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.24.7",
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.27.12",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^22.5.1",
    "@vitest/coverage-istanbul": "^3.0.5",
    "bumpp": "^9.5.2",
    "esbuild": "^0.23.1",
    "jsdom": "^25.0.0",
    "rollup": "^4.21.0",
    "rollup-plugin-dts": "^6.1.1",
    "rollup-plugin-esbuild": "^6.1.1",
    "rollup-plugin-node-externals": "^7.1.3",
    "tinyglobby": "^0.2.10",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitepress": "^1.3.4",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=14.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
