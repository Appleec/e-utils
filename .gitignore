# Git ignore
# https://git-scm.com/docs/gitignore
backup
scripts/*
!scripts/push-gh-pages.ts
!scripts/release.ts
!scripts/build.ts
!scripts/publish.ts
!scripts/utils.ts
package

# Tools & Text Editors
.idea
.sublime-*
.vscode

# Dependency directories
node_modules/

# Logs
logs
*.log*

# Runtime data
pids
*.pid
*.seed

# Build / generate output
cdn
dist
out
coverage
*.tgz

# Temporary files
.tmp
.temp
.grunt
.lock-wscript

# Docs config
.chiller
docs/.vitepress/cache
docs/.vitepress/dist

# Others
.git
.DS_Store
.DS_STORE
.cache
.npm
.yarn
.stylelintcache
.eslintcache
package-lock.json
.changeset
.env

